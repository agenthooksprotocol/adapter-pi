{
  "name": "@agenthooksprotocol/adapter-pi",
  "version": "0.1.0",
  "type": "module",
  "description": "Agent Hooks Protocol adapter for the pi coding agent, as a pi extension",
  "license": "Apache-2.0",
  "repository": "github:agenthooksprotocol/adapter-pi",
  "keywords": [
    "pi-package",
    "agent-hooks-protocol"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test test/unit",
    "test:e2e": "npm run build && bun test --timeout 60000 test/e2e",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "agenthooksprotocol": "0.11.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/bun": "1.3.5",
    "pi-floor": "npm:@earendil-works/pi-coding-agent@1.0.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
